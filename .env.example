# Copia este archivo como .env y completa con tus credenciales de Supabase
# Requiere: Expo SDK 53+ con soporte de variables de entorno

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# En Expo, las variables EXPO_PUBLIC_* están disponibles en tiempo de ejecución
# en web y nativo. Para App.js usa process.env.EXPO_PUBLIC_* (o define un script
# de dotenv para local si usas Expo CLI).